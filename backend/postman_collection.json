          "raw": "{\n  \"sources\": [\n    {\n      \"label\": \"TechCorp Memo (Leaked)\",\n      \"type\": \"PDF\",\n      \"content\": \"We are announcing a 15% workforce reduction to optimize costs.\",\n      \"received_at\": \"2026-05-16T10:00:00Z\"\n    },\n    {\n      \"label\": \"Reuters News\",\n      \"type\": \"URL\",\n      \"content\": \"TechCorp confirms 25% layoffs amidst massive stock selloff and executive departures.\",\n      \"received_at\": \"2026-05-16T11:00:00Z\"\n    }\n  ],\n  \"constraints\": {\n    \"publish_deadline_hours\": 2\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/v1/run",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "v1", "run"]
        }
      }
    },
